# Copy to .env for local dev, or set these in Railway's client service
# environment variables for production. CRA bakes these in at build time,
# so a var added here won't take effect until the app is rebuilt.

# Base URL of the API server.
REACT_APP_API_URL=http://localhost:5000

# GA4 Measurement ID (looks like G-XXXXXXXXXX). Analytics.js no-ops
# entirely - no script injected, no calls made - when this isn't set,
# so it's safe to leave blank in local dev.
REACT_APP_GA_MEASUREMENT_ID=
